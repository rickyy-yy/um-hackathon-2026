# ---------- Z.ai GLM ----------
ZAI_API_KEY=your_zai_api_key_here
ZAI_BASE_URL=https://api.z.ai/v1
ZAI_MODEL_NAME=glm-4

# ---------- Database ----------
POSTGRES_USER=kira2lah_user
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=kira2lah
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://kira2lah_user:change_me_db_password@db:5432/kira2lah
SYNC_DATABASE_URL=postgresql://kira2lah_user:change_me_db_password@db:5432/kira2lah

# ---------- Auth ----------
JWT_SECRET_KEY=change_me_jwt_secret_please_set_something_long_and_random
JWT_ALGORITHM=HS256
# 24h access token by default — refresh tokens can be added post-hackathon.
JWT_EXPIRATION_MINUTES=1440
COOKIE_SECURE=false

# ---------- OTP / SMS ----------
# SMS_PROVIDER: "console" prints OTPs to backend logs (hackathon stub).
# Real providers (twilio, vonage, etc.) can be wired in by implementing a
# subclass of SmsProvider in backend/app/services/sms_service.py.
SMS_PROVIDER=console
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_WINDOW_SECONDS=900

# ---------- Guest (Try Now) flow ----------
GUEST_TTL_HOURS=24
GUEST_REPORTS_PER_IP_PER_DAY=3

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@kira2lah.local

# ---------- WhatsApp ----------
WHATSAPP_API_KEY=
WHATSAPP_API_URL=

# ---------- Application URLs ----------
# Server-side (Docker internal) — used by Next.js proxy rewrites.
BACKEND_URL=http://backend:8000
FRONTEND_URL=http://localhost:3000
STREAMLIT_URL=http://streamlit:8501
# Browser-visible URLs.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_STREAMLIT_URL=http://localhost:8501

# ---------- Misc ----------
SECRET_KEY=change_me_app_secret
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=60

# ---------- Context7 MCP (optional) ----------
# Free API key at https://context7.com/dashboard for higher rate limits.
CONTEXT7_API_KEY=
