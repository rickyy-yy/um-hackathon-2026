# ---------- Z.ai GLM ----------
ZAI_API_KEY=your_zai_api_key_here
ZAI_BASE_URL=https://api.z.ai/v1
ZAI_MODEL_NAME=glm-4

# ---------- Database ----------
POSTGRES_USER=kira2je_user
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=kira2je
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://kira2je_user:change_me_db_password@db:5432/kira2je
SYNC_DATABASE_URL=postgresql://kira2je_user:change_me_db_password@db:5432/kira2je

# ---------- Auth ----------
JWT_SECRET_KEY=change_me_jwt_secret_please_set_something_long_and_random
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
COOKIE_SECURE=false

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email_here
SMTP_PASSWORD=your_email_password_here
SMTP_FROM=no-reply@kira2je.local

# ---------- WhatsApp ----------
WHATSAPP_API_KEY=your_whatsapp_api_key_here
WHATSAPP_API_URL=https://api.whatsapp.example.com

# ---------- Application URLs ----------
BACKEND_URL=http://backend:8000
FRONTEND_URL=http://localhost:3000
STREAMLIT_URL=http://streamlit:8501
STREAMLIT_PUBLIC_URL=http://localhost:8501
PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_STREAMLIT_URL=http://localhost:8501

# ---------- Misc ----------
SECRET_KEY=change_me_app_secret
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=60
