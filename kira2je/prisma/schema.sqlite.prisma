generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String              @id @default(cuid())
  phone        String              @unique
  name         String?
  businessName String?
  businessType String?             // "restaurant" | "cafe" | "catering" | "other"
  language     String              @default("en")
  posType      String?
  whatsappNum  String?
  createdAt    DateTime            @default(now())
  reports      Report[]
  invoices     Invoice[]
  posUploads   PosUpload[]
  mappings     IngredientMapping[]
  whatIf       WhatIfTurn[]
  overrides    MenuItemOverride[]
}

model Invoice {
  id            String    @id @default(cuid())
  userId        String
  supplierName  String?
  invoiceDate   DateTime?
  total         Float?
  lineItems     String?   // JSON stored as string in SQLite
  rawImageUrl   String?
  ocrConfidence String?
  status        String    @default("pending")
  month         String
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id])

  @@index([userId, month])
  @@index([userId, status])
}

model PosUpload {
  id         String   @id @default(cuid())
  userId     String
  month      String
  fileName   String
  rowCount   Int?
  parsedData String?  // JSON as string
  posType    String?
  columnMap  String?  // JSON as string
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, month])
}

model IngredientMapping {
  id         String   @id @default(cuid())
  userId     String
  ingredient String
  supplier   String?
  menuItems  String   // JSON as string
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, ingredient, supplier])
}

model Report {
  id          String   @id @default(cuid())
  userId      String
  month       String
  monthView   String   // JSON as string
  trendsView  String   // JSON as string
  generatedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  whatIf      WhatIfTurn[]

  @@unique([userId, month])
  @@index([userId, generatedAt])
}

model MenuItemOverride {
  id         String   @id @default(cuid())
  userId     String
  itemName   String
  type       String   // "service" | "manual"
  manualCost Float?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, itemName])
}

model WhatIfTurn {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id])
  question  String
  answer    String
  createdAt DateTime @default(now())

  @@index([userId, reportId])
}
