generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String              @id @default(cuid())
  phone        String              @unique
  name         String?
  businessName String?
  businessType String?             // "restaurant" | "cafe" | "catering" | "other"
  language     String              @default("en") // "en" | "bm"
  posType      String?             // "storehub" | "loyverse" | "custom"
  whatsappNum  String?
  createdAt    DateTime            @default(now())
  reports      Report[]
  invoices     Invoice[]
  posUploads   PosUpload[]
  mappings     IngredientMapping[]
  whatIf       WhatIfTurn[]
}

model Invoice {
  id            String    @id @default(cuid())
  userId        String
  supplierName  String?
  invoiceDate   DateTime?
  total         Float?
  lineItems     Json?     // [{ description, quantity, unit, unitPrice, total }]
  rawImageUrl   String?
  ocrConfidence String?   // "high" | "medium" | "low"
  status        String    @default("pending") // "pending" | "confirmed" | "failed"
  month         String    // "2026-04"
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id])

  @@index([userId, month])
  @@index([userId, status])
}

model PosUpload {
  id          String   @id @default(cuid())
  userId      String
  month       String   // "2026-04"
  fileName    String
  rowCount    Int?
  parsedData  Json?    // Aggregated item-level summary
  posType     String?  // "storehub" | "loyverse" | "custom"
  columnMap   Json?    // For custom POS: { itemName: "col_B", price: "col_D", ... }
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, month])
}

model IngredientMapping {
  id         String   @id @default(cuid())
  userId     String
  ingredient String   // "chicken breast"
  supplier   String?
  menuItems  Json     // ["nasi ayam", "chicken chop"]
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, ingredient, supplier])
}

model Report {
  id          String   @id @default(cuid())
  userId      String
  month       String   // "2026-04"
  monthView   Json     // Cached "This month" view
  trendsView  Json     // Cached "Trends" view
  generatedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  whatIf      WhatIfTurn[]

  @@unique([userId, month])
  @@index([userId, generatedAt])
}

model WhatIfTurn {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id])
  question  String
  answer    String
  createdAt DateTime @default(now())

  @@index([userId, reportId])
}
