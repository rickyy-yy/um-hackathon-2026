# Local SQLite (run with: npm run dev:local)
DATABASE_URL="file:./prisma/dev.db"

# OR: PostgreSQL for Vercel / cloud dev (run with: npm run dev)
# Get this from: https://neon.tech → create project → copy connection string
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Cookie secret for signed session (use a long random string in production)
SESSION_SECRET="dev-secret-change-me-before-prod"

# LLM configuration — all calls go through lib/llm.ts
# Leave MOCK_LLM=true to run the full app without any API key (canned BM responses).
MOCK_LLM=true

# When MOCK_LLM=false, set these to any OpenAI-compatible endpoint.
# If the real provider fails for any reason (auth, network, rate limit,
# Zod validation), lib/llm.ts automatically falls back to the mock so the
# UI never breaks — watch server logs for [llm:<task>] warnings.
#
# For Z.AI GLM (the default Z.AI international endpoint is OpenAI-compatible):
#   LLM_BASE_URL=https://api.z.ai/api/paas/v4
#   LLM_API_KEY=your-zai-key
#   LLM_MODEL=glm-4-plus     # or glm-4.5-air, glm-5, etc.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Gemini API — used for OCR (photo upload feature).
# OCR pipeline: Gemini 2.5 Flash reads the image → GLM-5.1 extracts structured JSON.
# Falls back to tesseract.js (local OCR) if GEMINI_API_KEY is unset or Gemini fails.
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
